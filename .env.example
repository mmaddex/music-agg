# --- TIDAL app credentials (https://developer.tidal.com/dashboard) ---
# Create an app, then add the redirect URI below to the app's "Redirect URIs".
TIDAL_CLIENT_ID=
# Optional. The authorization-code + PKCE flow does not require it, but it is
# sent to the token endpoint when present (mirrors the official TIDAL SDK).
TIDAL_CLIENT_SECRET=
# Must exactly match a redirect URI registered for the app.
# In development the Vite dev server (port 5173) proxies /auth to the API server.
TIDAL_REDIRECT_URI=http://localhost:5173/auth/callback
# Space-separated OAuth scopes. Defaults to the ones this app needs.
# TIDAL_SCOPES=user.read search.read playlists.read playlists.write collection.read collection.write

# --- Server ---
PORT=3000
# Public URL of the web app; used to redirect back after login. Defaults to the origin of TIDAL_REDIRECT_URI.
# APP_BASE_URL=http://localhost:5173
# Max upload size in megabytes.
# MAX_UPLOAD_MB=200
# Idle minutes before an in-memory session (tokens + uploaded export) is discarded.
# SESSION_TTL_MINUTES=240

# --- Optional: YouTube Data API key ---
# YouTube playlist exports contain only video IDs. Titles are looked up via YouTube's
# public oEmbed endpoint by default (no key needed). With a key, lookups are batched
# 50 at a time and also return durations, which improves matching.
# YOUTUBE_API_KEY=
