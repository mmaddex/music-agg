# Copy to .env for local development:  node --env-file=.env src/server.js

# From https://developer.tidal.com → Dashboard → your app
TIDAL_CLIENT_ID=

# Shared Postgres for the web service and the workflow tasks.
DATABASE_URL=postgresql://musicagg:musicagg@localhost:5432/musicagg_dev
# DATABASE_SSL=true            # override TLS auto-detection (external Render URLs need TLS)

# Encrypts stored TIDAL tokens. Web service and Workflow service MUST use the same value.
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Signs the session cookie. Required in production.
SESSION_SECRET=change-me

# Workflows. Leave unset locally to run the tasks inside the web process ("inline").
# In production set both so the web service starts runs on Render Workflows.
# RENDER_API_KEY=rnd_...
# WORKFLOW_SLUG=music-agg-workflows
# WORKFLOW_MODE=render|inline

# Tuning (read by the workflow tasks)
# TIDAL_MIN_INTERVAL_MS=200    # floor for the shared TIDAL pace (it adapts to 429s itself)
# MATCH_CHUNK_SIZE=100         # tracks per matchChunk run
# MATCH_PARALLELISM=2          # matchChunk runs in flight per import
# TIDAL_START_INTERVAL_MS=750  # shared pace starts here, then adapts to TIDAL's limit
# LOG_LEVEL=info               # debug | info | warn | error | silent

# Not used by the user-login (PKCE) flow; TIDAL's token endpoint only needs the client id.
# TIDAL_CLIENT_SECRET=

# TIDAL_REDIRECT_URI=http://localhost:3000/auth/callback
# PUBLIC_BASE_URL=http://localhost:3000
# PORT=3000
# MAX_UPLOAD_MB=100
# IMPORT_RETENTION_DAYS=30
