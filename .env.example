# Copy to .env for local development (node --env-file=.env src/server.js)

# From https://developer.tidal.com → Dashboard → your app
TIDAL_CLIENT_ID=

# Not used by the user-login (authorization code + PKCE) flow; TIDAL's token endpoint
# only needs the client id there. Keep it out of the app unless a future feature needs
# client-credentials (catalogue-only) calls.
# TIDAL_CLIENT_SECRET=

# Where TIDAL sends the user back after login. Must exactly match a redirect URI
# registered for your app. Defaults to $PUBLIC_BASE_URL/auth/callback.
# TIDAL_REDIRECT_URI=http://localhost:3000/auth/callback

# Public URL of the app (Render provides RENDER_EXTERNAL_URL automatically).
# PUBLIC_BASE_URL=http://localhost:3000

# Signs the session cookie. Required in production.
SESSION_SECRET=change-me

# PORT=3000
# MAX_UPLOAD_MB=100
# Minimum ms between TIDAL API calls per user (raise if TIDAL returns 429s)
# TIDAL_MIN_INTERVAL_MS=200
